[Unit]
Description=Launch the autonomy state estimation stack
After=network-online.target ros-core.service dev-ttyAMA0.device
Wants=network-online.target

[Service]
Type=simple
User=__USER__
ExecStart=__REPO_ROOT__/modules/autonomy_pi/scripts/ros_entrypoint.sh ros2 launch autonomy_bringup estimation.launch.yaml
KillSignal=SIGINT
TimeoutStopSec=30
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target

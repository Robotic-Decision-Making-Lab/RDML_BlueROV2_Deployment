[Unit]
Description=Launch the autonomy control stack
Requires=docker.service
After=docker.service network-online.target ros-core.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/docker compose -f __REPO_ROOT__/modules/autonomy_pi/docker/docker-compose.yml up --detach --no-deps --wait --wait-timeout 300 controllers
ExecStop=/usr/bin/docker compose -f __REPO_ROOT__/modules/autonomy_pi/docker/docker-compose.yml stop controllers
TimeoutStartSec=360

[Install]
WantedBy=multi-user.target

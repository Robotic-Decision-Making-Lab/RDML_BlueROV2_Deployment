<?xml version="1.0" ?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">

  <name>autonomy_bringup</name>
  <version>0.1.0</version>
  <description>Launch files for the autonomy Raspberry Pi 5</description>

  <maintainer email="evanp922@gmail.com">Evan Palmer</maintainer>
  <license>MIT</license>

  <url type="repository">https://github.com/Robotic-Decision-Making-Lab/RDML_BlueROV2_Deployment.git</url>
  <url type="bugtracker">https://github.com/Robotic-Decision-Making-Lab/RDML_BlueROV2_Deployment/issues</url>

  <author>Evan Palmer</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>robot_localization</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>ros2_control</exec_depend>
  <exec_depend>autonomy_description</exec_depend>
  <exec_depend>nucleus_driver</exec_depend>
  <exec_depend>bme680_driver</exec_depend>
  <exec_depend>autonomy_teensy</exec_depend>
  <exec_depend>autonomy_routers</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>controller_coordinator</exec_depend>
  <exec_depend>impedance_controller</exec_depend>
  <exec_depend>thruster_allocation_matrix_controller</exec_depend>
  <exec_depend>thruster_controllers</exec_depend>
  <exec_depend>thruster_hardware</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
